{
  "name": "hak-tracker-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.hak.tracker",
    "productName": "HAK Wholesales Tracker",
    "files": [
      "electron/**/*",
      "../app/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "publish": {
      "provider": "generic",
      "url": "https://tracker.yourdomain.com/downloads"
    }
  }
}
